<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="warn" monitorInterval="30">
    <Properties>
        <!-- Choix du répertoire utilisé pour la génération des logs -->
        <Property name="basePath">${env:LOG_HOME}/commandor2</Property>
        <Property name="patternLog">%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1}:%L - %m%n</Property>
        <Property name="patternUtiliseFichiers">${patternLog}</Property>
        <Property name="jdbcCommandorHost">BLO-SQL-PROD01</Property>
        <Property name="jdbcCommandorInstance">COMMANDOR</Property>
        <Property name="jdbcCommandorLogDbName">pg_commandorv2_logs</Property>
        <Property name="jdbcCommandorUserName">SQL-COMMANDOR-RW</Property>
        <Property name="jdbcCommandorPassword">{Set here password to SQL-COMMANDOR-RW}</Property>
    </Properties>
    <Appenders>
        <RollingFile name="fileLogger" fileName="${basePath}/commandor2-common.log"
                     filePattern="${basePath}/old/commandor2-common_%02i.log">
            <PatternLayout charset="UTF-8">
                <pattern>${patternUtiliseFichiers}</pattern>
            </PatternLayout>
            <Policies>
                <OnStartupTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="5 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="20"/><!-- Nb fichiers max à conserver -->
        </RollingFile>
        <RollingFile name="fileDatabase" fileName="${basePath}/commandor2-database.log"
                     filePattern="${basePath}/old/commandor2-database_%02i.log">
            <PatternLayout charset="UTF-8">
                <pattern>${patternUtiliseFichiers}</pattern>
            </PatternLayout>
            <Policies>
                <OnStartupTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="5 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="60"/><!-- Nb fichiers max à conserver -->
        </RollingFile>
        <RollingFile name="fileLoggerNavetteCompute" fileName="${basePath}/commandor2-navette-compute.log"
                     filePattern="${basePath}/old/commandor2-navette-compute_%02i.log">
            <PatternLayout charset="UTF-8">
                <pattern>${patternUtiliseFichiers}</pattern>
            </PatternLayout>
            <Policies>
                <OnStartupTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="5 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="20"/><!-- Nb fichiers max à conserver -->
        </RollingFile>
        <RollingFile name="fileLoggerImport" fileName="${basePath}/commandor2-import.log"
                     filePattern="${basePath}/old/commandor2-import_%02i.log">
            <PatternLayout charset="UTF-8">
                <pattern>${patternUtiliseFichiers}</pattern>
            </PatternLayout>
            <Policies>
                <OnStartupTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="5 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="20"/><!-- Nb fichiers max à conserver -->
        </RollingFile>

        <JDBC name="jdbc_navetteComputeLog" tableName="log_compute" ignoreExceptions="false">
            <PoolingDriver
                    connectionString="jdbc:sqlserver://${jdbcCommandorHost}\${jdbcCommandorInstance};databaseName=${jdbcCommandorLogDbName};applicationName=${jdbcCommandorLogDbName}?useServerPrepStmts=true;trustServerCertificate=true;loginTimeout=30;"
                    userName="${jdbcCommandorUserName}"
                    password="${jdbcCommandorPassword}"
                    driverClassName="com.microsoft.sqlserver.jdbc.SQLServerDriver">
                <PoolableConnectionFactory
                        autoCommitOnReturn="true"
                        cacheState="false"
                        defaultAutoCommit="false"
                        defaultCatalog=""
                        defaultQueryTimeoutSeconds="0"
                        defaultReadOnly="false"
                        defaultTransactionIsolation="-1"
                        fastFailValidation="true"
                        maxConnLifetimeMillis="-1"
                        maxOpenPreparedStatements="8"
                        poolStatements="false"
                        rollbackOnReturn="true"
                        validationQuery=""
                        validationQueryTimeoutSeconds="-1">
                </PoolableConnectionFactory>
            </PoolingDriver>

            <Column name="eventDate" isEventTimestamp="true"/>
            <ColumnMapping name="thread" pattern="%thread"/>
            <ColumnMapping name="level" pattern="%level"/>
            <ColumnMapping name="logger" pattern="%logger"/>
            <ColumnMapping name="exception" pattern="%ex{full}"/>
            <ColumnMapping name="message" pattern="%message"/>
            <ColumnMapping name="method" pattern="%l%n"/>
            <ColumnMapping name="erreur" pattern="%K{erreur}"/>
            <ColumnMapping name="details" pattern="%K{details}"/>
            <ColumnMapping name="col1" pattern="%K{col1}"/>
            <ColumnMapping name="col2" pattern="%K{col2}"/>
            <ColumnMapping name="col3" pattern="%K{col3}"/>
            <ColumnMapping name="col4" pattern="%K{col4}"/>
            <ColumnMapping name="col5" pattern="%K{col5}"/>
        </JDBC>

        <JDBC name="databaseAppenderCommon" tableName="dbo.log4j_common">
            <PoolingDriver
                    connectionString="jdbc:sqlserver://${jdbcCommandorHost}\${jdbcCommandorInstance};databaseName=${jdbcCommandorLogDbName};applicationName=${jdbcCommandorLogDbName}?useServerPrepStmts=true;trustServerCertificate=true;loginTimeout=30;"
                    userName="${jdbcCommandorUserName}"
                    password="${jdbcCommandorPassword}"
                    driverClassName="com.microsoft.sqlserver.jdbc.SQLServerDriver">
                <PoolableConnectionFactory
                        autoCommitOnReturn="true"
                        cacheState="false"
                        defaultAutoCommit="false"
                        defaultCatalog=""
                        defaultQueryTimeoutSeconds="0"
                        defaultReadOnly="false"
                        defaultTransactionIsolation="-1"
                        fastFailValidation="true"
                        maxConnLifetimeMillis="-1"
                        maxOpenPreparedStatements="8"
                        poolStatements="false"
                        rollbackOnReturn="true"
                        validationQuery=""
                        validationQueryTimeoutSeconds="-1">
                </PoolableConnectionFactory>
            </PoolingDriver>
            <Column name="eventDate" isEventTimestamp="true"/>
            <ColumnMapping name="level" pattern="%level"/>
            <ColumnMapping name="logger" pattern="%logger"/>
            <ColumnMapping name="message" pattern="%message"/>
            <ColumnMapping name="exception" pattern="%ex{full}"/>
            <ColumnMapping name="thread" pattern="%thread"/>
        </JDBC>
    </Appenders>

    <Loggers>
        <Root level="info">
            <appender-ref ref="fileLogger"/>
        </Root>
        <Logger name="com.tlgpro.blois.commandor.service.commandor.impl.MailServiceImpl" level="off">
            <appender-ref ref="fileLogger"/>
        </Logger>
        <Logger name="com.tlgpro.blois.commandor.tasks" level="off">
            <appender-ref ref="fileLogger"/>
        </Logger>
        <AsyncLogger name="com2.tlgpro.blois.commandor.tasks.LogsMetier.NavetteComputeLogs" level="info"
                     additivity="false">
            <appender-ref ref="fileLoggerNavetteCompute"/>
            <appender-ref ref="jdbc_navetteComputeLog" level="error"/>
        </AsyncLogger>
        <Logger name="com.tlgpro.blois.commandor.tasks.ImportPlanning" level="info" additivity="false">
            <appender-ref ref="fileLoggerImport"/>
            <appender-ref ref="databaseAppenderCommon"/>
        </Logger>
        <Logger name="com.tlgpro.blois.commandor.tasks.ImportWorkTimes" level="info" additivity="false">
            <appender-ref ref="fileLoggerImport"/>
            <appender-ref ref="databaseAppenderCommon"/>
        </Logger>
        <Logger name="com.tlgpro.blois.commandor.tasks.ImportManPo" level="info" additivity="false">
            <appender-ref ref="fileLoggerImport"/>
            <appender-ref ref="databaseAppenderCommon"/>
        </Logger>
        <Logger name="com.tlgpro.blois.commandor.tasks.ImportMasterData" level="info" additivity="false">
            <appender-ref ref="fileLoggerImport"/>
            <appender-ref ref="databaseAppenderCommon"/>
        </Logger>
        <Logger name="org.hibernate.SQL" level="off" additivity="false">
            <appender-ref ref="fileDatabase"/>
        </Logger>
        <Logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="off" additivity="false">
            <appender-ref ref="fileDatabase"/>
        </Logger>
        <Logger name="org.hibernate.engine.internal.StatisticalLoggingSessionEventListener" level="off"
                additivity="false">
            <appender-ref ref="fileDatabase"/>
        </Logger>
    </Loggers>
</Configuration>
